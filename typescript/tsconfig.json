{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "types": [
      "node"
    ],
    "paths": {
      "bytnode": [
        "./src/index.ts"
      ],
      "bytnode/mcp": [
        "./src/mcp.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "examples"
  ]
}
