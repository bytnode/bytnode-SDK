{
  "_comment": "What the public contract does not state in machine-readable form. Closed sets of values come from the contract's `enum`; the literals here only NAME them (matched by their values).",
  "literals": [
    {"name": "Timeframe", "values": ["1m", "5m", "15m", "30m", "1h", "4h", "1d"], "description": "Bucket size of a bucketed series."},
