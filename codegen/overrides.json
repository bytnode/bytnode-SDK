    {"name": "OptionsTimeframe", "values": ["5m", "15m", "30m", "1h", "4h", "1d"], "description": "Bucket size on options routes (`1m` is not served on options)."},
    {"name": "IntradayTimeframe", "values": ["1m", "5m", "15m", "1h", "4h", "1d"], "description": "Candle size of an intraday macro series (no `30m`)."},
    {"name": "CoarseTimeframe", "values": ["1h", "4h", "1d"], "description": "Optional step of a history aggregated to the last reading of each closed bucket."},
    {"name": "Asset", "values": ["BTC", "ETH"], "description": "Underlying asset of the options and spot ETF routes."},
    {"name": "Order", "values": ["asc", "desc"], "description": "Reading order: `desc` (most recent first, the default) or `asc` (oldest first)."},
    {"name": "MiningDataset", "values": ["concentration", "rewards", "difficulty", "fee_rates"], "description": "Mining series: pool shares, block rewards, difficulty or fee rates."}
